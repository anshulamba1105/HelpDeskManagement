@model HelpDesk.Api.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<h2>Delete Ticket</h2>
<h4 class="text-danger">Are you sure you want to delete this ticket?</h4>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Priority</dt>
        <dd class="col-sm-10">@Model.Priority</dd>
        
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        
        <dt class="col-sm-2">Raised By</dt>
        <dd class="col-sm-10">@Model.RaisedBy</dd>
    </dl>
    
    <form asp-action="Delete" class="mt-4">
        <!-- Hidden input is crucial so the controller knows which ID to delete -->
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>