@model HelpDesk.Api.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<h2>Ticket Details</h2>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Ticket ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        
        <dt class="col-sm-2">Priority</dt>
        <dd class="col-sm-10">
            <span class="badge bg-secondary">@Model.Priority</span>
        </dd>
        
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        
        <dt class="col-sm-2">Raised By</dt>
        <dd class="col-sm-10">@Model.RaisedBy</dd>
        
        <dt class="col-sm-2">Created Date</dt>
        <dd class="col-sm-10">@Model.CreatedDate.ToString("g")</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Ticket</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>